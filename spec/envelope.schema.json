{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sproutpad.ai/spec/envelope.schema.json",
  "title": "Governed Agent Spend — response envelope",
  "description": "Machine-checkable definition of the normative wire format in spec §3 (https://sproutpad.ai/spec.md). formatVersion 2 uses typed actions. Field names are normative — no renaming, no restyling.",
  "oneOf": [
    { "$ref": "#/$defs/successEnvelope" },
    { "$ref": "#/$defs/errorEnvelope" }
  ],
  "$defs": {
    "formatVersion": {
      "description": "Wire dialect version. 2 is the agent typed-actions dialect.",
      "const": 2
    },
    "agentAction": {
      "description": "Typed continuation (§3.1). Agents execute these; they MUST NOT parse prose nextActions.",
      "oneOf": [
        { "$ref": "#/$defs/agentToolAction" },
        { "$ref": "#/$defs/agentUrlAction" },
        { "$ref": "#/$defs/agentStopAction" },
        { "$ref": "#/$defs/agentManualAction" }
      ]
    },
    "agentToolAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "arguments"],
      "properties": {
        "kind": { "const": "tool" },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "arguments": { "type": "object" },
        "requiredArguments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
          "maxItems": 50
        },
        "requiredOneOf": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
            "minItems": 2,
            "maxItems": 10
          },
          "maxItems": 20
        },
        "afterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
      }
    },
    "agentUrlAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "purpose", "requiresHuman"],
      "properties": {
        "kind": { "const": "url" },
        "url": { "type": "string", "format": "uri" },
        "purpose": {
          "type": "string",
          "enum": ["authenticate", "approve", "billing", "review", "docs"]
        },
        "requiresHuman": { "const": true }
      }
    },
    "agentStopAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "stop" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
      }
    },
    "agentManualAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "purpose", "instruction", "requiresHuman"],
      "properties": {
        "kind": { "const": "manual" },
        "purpose": {
          "type": "string",
          "enum": ["dns_configuration", "external_configuration"]
        },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "details": { "type": "object" },
        "requiresHuman": { "const": true }
      }
    },
    "actions": {
      "type": "array",
      "description": "Ordered typed continuations. Empty arrays are invalid when a contract requires a continuation.",
      "items": { "$ref": "#/$defs/agentAction" },
      "maxItems": 50
    },
    "actionableActions": {
      "description": "A non-empty typed continuation list.",
      "allOf": [{ "$ref": "#/$defs/actions" }],
      "minItems": 1
    },
    "successEnvelope": {
      "type": "object",
      "description": "Success. Read-only responses carry any shape under `data`; operations that promise a continuation MUST include typed `actions` either at the top level or inside `data` (operation contract decides). Public mutations MUST satisfy #/$defs/mutatingSuccessEnvelope (§3.1).",
      "required": ["data"],
      "properties": {
        "data": { "type": "object" },
        "actions": { "$ref": "#/$defs/actions" },
        "formatVersion": { "$ref": "#/$defs/formatVersion" },
        "replayed": {
          "type": "boolean",
          "description": "Transport metadata. True only when an Idempotency-Key replay returned the stored response without re-executing the mutation."
        }
      },
      "not": {
        "anyOf": [
          { "required": ["blockedBy"] },
          { "required": ["nextActions"] },
          { "required": ["resolution"] }
        ]
      }
    },
    "inventoryReadSuccessEnvelope": {
      "description": "Success for inventory-style reads that MUST NOT teach a typed continuation (neither top-level `actions` nor `data.actions`). Binding: GET /v1/projects/{id}/status. See /spec.md §3.3. Not the product's 'direct API vs code-mode' meaning of direct-only — inventory read, no continuations.",
      "allOf": [
        { "$ref": "#/$defs/successEnvelope" },
        {
          "type": "object",
          "not": { "required": ["actions"] },
          "properties": {
            "data": {
              "type": "object",
              "not": { "required": ["actions"] }
            }
          }
        }
      ]
    },
    "actionableSuccessEnvelope": {
      "description": "A successful operation that is contractually required to teach the next step via typed actions. Fake-money sandbox transitions use data.actions; agent REST/MCP use the operation's published location for actions.",
      "allOf": [
        { "$ref": "#/$defs/successEnvelope" },
        {
          "type": "object",
          "anyOf": [
            {
              "required": ["actions"],
              "properties": {
                "actions": { "$ref": "#/$defs/actionableActions" }
              }
            },
            {
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["actions"],
                  "properties": {
                    "actions": { "$ref": "#/$defs/actionableActions" }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "mutatingSuccessEnvelope": {
      "description": "The complete §3.1 envelope for every successful public mutation: governance evidence inside data and typed actions (never prose nextActions).",
      "allOf": [
        { "$ref": "#/$defs/actionableSuccessEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": { "$ref": "#/$defs/mutatingSuccessData" },
            "actions": { "$ref": "#/$defs/actions" },
            "formatVersion": { "$ref": "#/$defs/formatVersion" },
            "replayed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "mutatingSuccessData": {
      "type": "object",
      "description": "The §3.1 contract for the `data` object of a successful public mutation: receipt and undo are required. budgetRemainingUsd SHOULD appear on data or inside the operation payload; typed actions may appear here or at the envelope top level.",
      "required": ["receipt", "undo"],
      "properties": {
        "receipt": { "$ref": "#/$defs/receipt" },
        "undo": { "$ref": "#/$defs/undo" },
        "budgetRemainingUsd": { "type": "number", "minimum": 0 },
        "actions": { "$ref": "#/$defs/actions" }
      },
      "not": {
        "anyOf": [
          { "required": ["nextActions"] },
          { "required": ["replayed"] }
        ]
      }
    },
    "receipt": {
      "type": "object",
      "description": "What happened: the action, its costs, and provider references for everything created (§3.1).",
      "required": ["action", "oneTimeUsd", "monthlyDeltaUsd", "resources"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "oneTimeUsd": { "type": "number", "minimum": 0 },
        "monthlyDeltaUsd": { "type": "number" },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "provider", "externalId"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "externalId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "undo": {
      "description": "How to reverse the mutation: a concrete command/call with irreversible:false, or the explicit object {command:null, irreversible:true}. A bare null is invalid (§3.1).",
      "oneOf": [
        {
          "type": "object",
          "required": ["command", "irreversible"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "irreversible": { "const": false }
          }
        },
        {
          "type": "object",
          "required": ["command", "irreversible"],
          "properties": {
            "command": { "type": "null" },
            "irreversible": { "const": true }
          }
        }
      ]
    },
    "errorEnvelope": {
      "type": "object",
      "description": "Agent-facing error (§3.2). Always carries blockedBy, message, retryable, and typed actions. Generic resolution belongs only on human/dashboard surfaces and MUST NOT appear on agent REST/MCP.",
      "required": ["blockedBy", "message", "retryable", "actions"],
      "properties": {
        "blockedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*:[a-z0-9_.]+$",
          "description": "Namespaced gate identifier, e.g. policy:max_domain_price, budget:exceeded, input:invalid_domain."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S",
          "description": "The implementation trims before applying minLength, so a whitespace-only message is rejected. The pattern makes that expressible here."
        },
        "retryable": { "type": "boolean" },
        "actions": { "$ref": "#/$defs/actionableActions" },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*:[a-z0-9_.]+$",
          "description": "When present, MUST equal blockedBy. JSON Schema cannot require equality between two sibling properties, so that invariant is enforced by the implementation and pinned by its drift test; this declaration bounds the value to the same grammar as blockedBy."
        },
        "limit": { "type": "number" },
        "requested": { "type": "number" },
        "currentVersion": { "type": "number" },
        "formatVersion": { "$ref": "#/$defs/formatVersion" }
      },
      "additionalProperties": false,
      "not": { "required": ["resolution"] }
    },
    "humanErrorEnvelope": {
      "type": "object",
      "description": "Human-only error surface (dashboard/approvals/admin). MAY carry resolution. Agents MUST NOT depend on this shape.",
      "required": ["blockedBy"],
      "properties": {
        "blockedBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*:[a-z0-9_.]+$"
        },
        "message": { "type": "string" },
        "limit": { "type": "number" },
        "requested": { "type": "number" },
        "retryable": { "type": "boolean" },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "resolution": {
      "type": "object",
      "description": "Human-only legitimate path forward. Not part of the agent wire dialect.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "taskId": { "type": "string" },
        "hint": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "signupUrl": { "type": "string", "format": "uri" },
        "billingUrl": { "type": "string", "format": "uri" },
        "dashboardUrl": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" },
        "path": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
